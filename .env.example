# Flask Application Environment
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-in-production-1234567890

# Database
DATABASE_URL=sqlite:///instance/attendance_agent.db

# Processing Options
FRAME_RESIZE_WIDTH=640
FRAME_RESIZE_HEIGHT=480
TARGET_FPS=10
ATTENDANCE_CONFIDENCE_THRESHOLD=0.60
SUSTAINED_PRESENCE_SECONDS=30
MIN_OBSERVATION_COVERAGE=0.60
GRACE_PERIOD_SECONDS=10
LATE_ARRIVAL_MINUTES=10

# Audio Options
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_WINDOW_SECONDS=5

# Optional Pluggable LLM Integration (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b
USE_LOCAL_LLM=false

# Privacy & Security
RETAIN_RAW_VIDEO=false
RETAIN_RAW_AUDIO=false
DATA_RETENTION_DAYS=90
